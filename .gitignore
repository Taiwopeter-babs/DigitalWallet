bin/
obj/
/packages/
Frontend/node_modules/
Frontend/.next/
Frontend/dist/
riderModule.iml
/_ReSharper.Caches/


# Local directory generated by terraform init
**/**/.terraform

# Ignore local variable files (often contain cleartext passwords/keys)
**/**.tfvars
**/**.tfvars.json

# Ignore local override files 
**/**/override.tf
**/**/override.tf.json
**/**/_override.tf
**/**/_override.tf.json

# CLI configuration files
**/**/.terraformrc
**/**/terraform.rc

# Log files
**/**/crash.log
**/**/crash.*.log

# ONLY ignore local state files if you use a remote backend (S3, GCS, Terraform Cloud)
# WARNING: If you are not using a remote backend, deleting/ignoring these could lose track of infrastructure.
**/**/.tfstate
**/**/.tfstate.backup
**/**/.tfstate.*
**/**/.terraform.tfstate.lock.info

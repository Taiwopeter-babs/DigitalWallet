{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgresqlDatabase": "Host=postgres;Database=digitalwalletdb;Username=digitalwalletuser;Password=digitalpassword;"
  },
  "Kafka": {
    "WalletProducer": {
      "BootstrapServers": "localhost:9092",
      "Acks": "All",
      "EnableIdempotence": true,
      "MessageSendMaxRetries": 3,
      "RetryBackoffMs": 1000,
      "WalletTransferTopic": "wallet-transfer",
      "WalletFundingTopic": "wallet-funding",
      "WalletCreationTopic": "wallet-creation",
      "WalletProducerKafkaKey": "wallet-service",
      "WalletDLQTopic": "wallet-dlq"
    },
    "WalletFundingWorker": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "history-wallet-funding-consumer-group",
      "AutoOffsetReset": "Earliest",
      "EnableAutoCommit": false,
      "Topic": "wallet-funding"
    },
    "WalletTransferWorker": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "history-wallet-transfer-consumer-group",
      "AutoOffsetReset": "Earliest",
      "EnableAutoCommit": false,
      "Topic": "wallet-transfer"
    },
    "WalletCreationWorker": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "history-wallet-creation-consumer-group",
      "AutoOffsetReset": "Earliest",
      "EnableAutoCommit": false,
      "Topic": "wallet-creation"
    }
  }
}